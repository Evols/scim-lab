---
import type { ScimEventRecord } from "../../db/schema.ts";
import JsonPayloadViewer from "./JsonPayloadViewer.astro";

interface Props {
  events: ScimEventRecord[];
  server_id: string;
  status_filter: string;
  method_filter: string;
}
const { events, server_id, status_filter, method_filter } = Astro.props;
const status_classes = (status: number) =>
  status < 300
    ? "border-[#bbf7d0] bg-[#f0fdf4] text-[#15803d]"
    : status < 400
      ? "border-[#dbeafe] bg-[#eff6ff] text-[#1d4ed8]"
      : "border-[#fecaca] bg-[#fef2f2] text-[#b91c1c]";
---

<div>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold tracking-[-0.03em]">Logs</h1><p class="mt-1 text-sm text-[#71717a]">
        The newest 1,000 requests, retained for 30 days.
      </p>
    </div>
    <form class="flex gap-2" method="GET">
      <input type="hidden" name="server" value={server_id} /><input type="hidden" name="view" value="logs" /><select
        class="h-9 rounded-md border border-[#d4d4d8] bg-white px-3 text-sm shadow-xs outline-none focus:ring-2 focus:ring-[#e4e4e7]"
        name="method"
        onchange="this.form?.submit()"
        ><option value="">All methods</option>{
          ["GET", "POST", "PUT", "PATCH", "DELETE"].map((method) => (
            <option value={method} selected={method === method_filter}>
              {method}
            </option>
          ))
        }</select
      ><select
        class="h-9 rounded-md border border-[#d4d4d8] bg-white px-3 text-sm shadow-xs outline-none focus:ring-2 focus:ring-[#e4e4e7]"
        name="status"
        onchange="this.form?.submit()"
        ><option value="">All statuses</option><option value="success" selected={status_filter === "success"}
          >Success</option
        ><option value="error" selected={status_filter === "error"}>Errors</option></select
      >
    </form>
  </div>

  <section class="mt-6 overflow-hidden rounded-lg border border-[#e4e4e7] bg-white shadow-xs">
    {
      events.length ? (
        <div class="divide-y divide-[#e4e4e7]">
          {events.map((event) => (
            <details class="group">
              <summary class="grid cursor-pointer list-none grid-cols-[18px_54px_1fr_auto] items-center gap-3 px-4 py-3 transition hover:bg-[#fafafa] focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#a1a1aa] md:grid-cols-[18px_64px_1fr_60px_110px_70px]">
                <span
                  class="text-lg leading-none text-[#a1a1aa] transition-transform group-open:rotate-90"
                  aria-hidden="true"
                >
                  ›
                </span>
                <span class="font-mono text-xs font-semibold text-[#3f3f46]">{event.method}</span>
                <code class="min-w-0 truncate font-mono text-xs text-[#52525b]">{event.path}</code>
                <span
                  class:list={[
                    "inline-flex justify-center rounded-full border px-2 py-0.5 font-mono text-[11px] font-medium",
                    status_classes(event.status),
                  ]}
                >
                  {event.status}
                </span>
                <time class="hidden text-xs text-[#71717a] md:block">
                  {event.created_at.toLocaleString("en", { hour: "2-digit", minute: "2-digit", second: "2-digit" })}
                </time>
                <span class="hidden text-right font-mono text-[11px] text-[#a1a1aa] md:block">
                  {event.duration_ms} ms
                </span>
              </summary>
              <div class="border-t border-[#e4e4e7] bg-[#f4f4f5] p-3 sm:p-4">
                <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1 px-1 text-[11px] text-[#71717a]">
                  <span>
                    Authentication{" "}
                    <strong class:list={["font-medium", event.auth_success ? "text-[#15803d]" : "text-[#b91c1c]"]}>
                      {event.auth_success ? "accepted" : "rejected"}
                    </strong>
                  </span>
                  {event.auth_mode && (
                    <span>
                      Mode <strong class="font-mono font-medium uppercase text-[#3f3f46]">{event.auth_mode}</strong>
                    </span>
                  )}
                  <span class="ml-auto hidden sm:inline">Payloads are sanitized before storage</span>
                </div>
                <div class="grid items-start gap-3 xl:grid-cols-2">
                  <JsonPayloadViewer
                    label="Request payload"
                    body={event.request_body}
                    tone="request"
                    truncated={event.request_truncated}
                  />
                  <JsonPayloadViewer
                    label="Response payload"
                    body={event.response_body}
                    tone="response"
                    truncated={event.response_truncated}
                  />
                </div>
              </div>
            </details>
          ))}
        </div>
      ) : (
        <div class="grid min-h-72 place-items-center px-6 py-12 text-center">
          <div>
            <>
              <span class="mx-auto grid size-10 place-items-center rounded-md border border-[#e4e4e7] bg-[#fafafa] font-mono text-xs text-[#71717a]">
                200
              </span>
              <h2 class="mt-4 text-sm font-semibold">Waiting for requests</h2>
              <p class="mt-1.5 max-w-sm text-sm leading-6 text-[#71717a]">
                Authenticated and rejected SCIM traffic will appear here with sanitized payloads.
              </p>
            </>
          </div>
        </div>
      )
    }
  </section>
</div>
