---
interface Props {
  label: string;
  href: string;
  active: boolean;
  compact?: boolean;
}

const { label, href, active, compact = false } = Astro.props;
---

<a
  class:list={[
    "rounded-md text-sm font-medium no-underline",
    compact ? "px-3 py-1.5" : "px-3 py-2 transition-colors",
    active
      ? "bg-[#f4f4f5] text-[#09090b]"
      : compact
        ? "text-[#71717a]"
        : "text-[#71717a] hover:bg-[#f4f4f5] hover:text-[#09090b]",
  ]}
  href={href}
  aria-current={active ? "page" : undefined}>{label}</a
>
