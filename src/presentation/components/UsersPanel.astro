---
import type { ScimUserRecord } from "../../db/schema.ts";

interface Props {
  users: ScimUserRecord[];
}
const { users } = Astro.props;

const user_details = new Map(
  users.map((user) => [
    user.id,
    JSON.stringify(
      {
        ...user.data,
        id: user.id,
        ...(user.external_id ? { externalId: user.external_id } : {}),
        userName: user.user_name,
        ...(user.display_name ? { displayName: user.display_name } : {}),
        active: user.active,
        meta: {
          created: user.created_at.toISOString(),
          lastModified: user.updated_at.toISOString(),
          version: user.version,
        },
      },
      null,
      2,
    ),
  ]),
);
---

<div>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold tracking-[-0.03em]">Users</h1><p class="mt-1 text-sm text-[#71717a]">
        Users provisioned through this SCIM server.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <input
        class="h-9 w-full rounded-md border border-[#d4d4d8] bg-white px-3 text-sm shadow-xs outline-none placeholder:text-[#a1a1aa] focus:ring-2 focus:ring-[#e4e4e7] sm:w-64"
        type="search"
        placeholder="Search users…"
        aria-label="Search users"
        data-user-search
      /><span
        class="inline-flex h-9 items-center rounded-md border border-[#e4e4e7] bg-white px-3 text-xs font-medium text-[#52525b] shadow-xs"
        >{users.length} / 100</span
      >
    </div>
  </div>

  <section class="mt-6 overflow-hidden rounded-lg border border-[#e4e4e7] bg-white shadow-xs">
    {
      users.length ? (
        <div class="overflow-x-auto">
          <table class="w-full min-w-[720px] border-collapse text-left">
            <>
              <thead class="bg-[#fafafa]">
                <tr class="border-b border-[#e4e4e7] text-xs text-[#71717a]">
                  <>
                    <th class="h-10 px-4 font-medium">User</th>
                    <th class="h-10 px-4 font-medium">Username</th>
                    <th class="h-10 px-4 font-medium">External ID</th>
                    <th class="h-10 px-4 font-medium">Status</th>
                    <th class="h-10 px-4 text-right font-medium">Updated</th>
                  </>
                </tr>
              </thead>
              <tbody>
                {users.map((user) => {
                  const detail_id = `user-details-${user.id}`;
                  const details = user_details.get(user.id) ?? "{}";
                  return (
                    <>
                      <tr
                        class="border-b border-[#e4e4e7] transition-colors hover:bg-[#fafafa]"
                        data-user-row
                        data-user-id={user.id}
                        data-search-value={`${user.display_name ?? ""} ${user.user_name} ${user.external_id ?? ""} ${details}`.toLowerCase()}
                      >
                        <td class="px-4 py-3">
                          <div class="flex items-center gap-2">
                            <button
                              class="grid size-7 shrink-0 cursor-pointer place-items-center rounded-md text-[#a1a1aa] transition hover:bg-[#e4e4e7] hover:text-[#3f3f46] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[#a1a1aa]"
                              type="button"
                              aria-expanded="false"
                              aria-controls={detail_id}
                              aria-label={`Show details for ${user.display_name ?? user.user_name}`}
                              data-user-toggle
                            >
                              <span
                                class="text-lg leading-none transition-transform"
                                aria-hidden="true"
                                data-user-chevron
                              >
                                ›
                              </span>
                            </button>
                            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-[#f4f4f5] text-xs font-medium text-[#52525b]">
                              {(user.display_name ?? user.user_name).slice(0, 1).toUpperCase()}
                            </span>
                            <span class="text-sm font-medium">{user.display_name ?? "Unnamed user"}</span>
                          </div>
                        </td>
                        <td class="px-4 py-3 font-mono text-xs text-[#3f3f46]">{user.user_name}</td>
                        <td class="px-4 py-3 font-mono text-xs text-[#71717a]">{user.external_id ?? "—"}</td>
                        <td class="px-4 py-3">
                          <span
                            class:list={[
                              "inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium",
                              user.active
                                ? "border-[#bbf7d0] bg-[#f0fdf4] text-[#15803d]"
                                : "border-[#e4e4e7] bg-[#fafafa] text-[#71717a]",
                            ]}
                          >
                            {user.active ? "Active" : "Inactive"}
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right text-xs text-[#71717a]">
                          {user.updated_at.toLocaleString("en", { dateStyle: "medium", timeStyle: "short" })}
                        </td>
                      </tr>
                      <tr id={detail_id} class="border-b border-[#e4e4e7]" data-user-details-for={user.id} hidden>
                        <td class="bg-[#fafafa] p-0" colspan="5">
                          <div class="grid gap-4 px-4 py-4 sm:px-6 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)]">
                            <div>
                              <h2 class="text-xs font-semibold uppercase tracking-wider text-[#71717a]">
                                Resource details
                              </h2>
                              <dl class="mt-3 grid gap-3 text-xs sm:grid-cols-2 lg:grid-cols-1">
                                <div>
                                  <dt class="text-[#a1a1aa]">SCIM ID</dt>
                                  <dd class="mt-0.5 break-all font-mono text-[#3f3f46]">{user.id}</dd>
                                </div>
                                <div>
                                  <dt class="text-[#a1a1aa]">Created</dt>
                                  <dd class="mt-0.5 text-[#3f3f46]">
                                    {user.created_at.toLocaleString("en", {
                                      dateStyle: "medium",
                                      timeStyle: "short",
                                    })}
                                  </dd>
                                </div>
                                <div>
                                  <dt class="text-[#a1a1aa]">Last modified</dt>
                                  <dd class="mt-0.5 text-[#3f3f46]">
                                    {user.updated_at.toLocaleString("en", {
                                      dateStyle: "medium",
                                      timeStyle: "short",
                                    })}
                                  </dd>
                                </div>
                                <div>
                                  <dt class="text-[#a1a1aa]">Version</dt>
                                  <dd class="mt-0.5 font-mono text-[#3f3f46]">{user.version}</dd>
                                </div>
                              </dl>
                            </div>
                            <div class="min-w-0 overflow-hidden rounded-md border border-[#d4d4d8] bg-white">
                              <div class="flex h-10 items-center justify-between border-b border-[#e4e4e7] px-3">
                                <h2 class="text-xs font-semibold text-[#3f3f46]">SCIM attributes</h2>
                                <button
                                  class="h-7 cursor-pointer rounded-md px-2.5 text-[11px] font-medium text-[#52525b] transition hover:bg-[#f4f4f5] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[#a1a1aa]"
                                  type="button"
                                  data-user-copy
                                >
                                  Copy JSON
                                </button>
                              </div>
                              <pre class="max-h-80 overflow-auto bg-[#18181b] p-4 text-[11px] leading-5 text-[#d4d4d8] sm:text-xs">
                                <code>{details}</code>
                              </pre>
                              <textarea class="sr-only" tabindex="-1" aria-hidden="true" data-user-json>
                                {details}
                              </textarea>
                            </div>
                          </div>
                        </td>
                      </tr>
                    </>
                  );
                })}
              </tbody>
            </>
          </table>
        </div>
      ) : (
        <div class="grid min-h-72 place-items-center px-6 py-12 text-center">
          <div>
            <>
              <span class="mx-auto grid size-10 place-items-center rounded-md border border-[#e4e4e7] bg-[#fafafa] text-[#71717a]">
                U
              </span>
              <h2 class="mt-4 text-sm font-semibold">No users yet</h2>
              <p class="mt-1.5 max-w-sm text-sm leading-6 text-[#71717a]">
                Provision a user through the SCIM endpoint and it will appear here.
              </p>
            </>
          </div>
        </div>
      )
    }
  </section>
</div>

<script>
  const user_search = document.querySelector<HTMLInputElement>("[data-user-search]");

  document.querySelectorAll<HTMLButtonElement>("[data-user-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const row = button.closest<HTMLElement>("[data-user-row]");
      const user_id = row?.dataset.userId;
      const details = user_id
        ? document.querySelector<HTMLTableRowElement>(`[data-user-details-for="${CSS.escape(user_id)}"]`)
        : null;
      if (!details) return;

      const expanded = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(expanded));
      const current_label = button.getAttribute("aria-label") ?? "Show user details";
      button.setAttribute(
        "aria-label",
        current_label.replace(expanded ? /^Show/ : /^Hide/, expanded ? "Hide" : "Show"),
      );
      details.hidden = !expanded;
      row?.classList.toggle("bg-[#fafafa]", expanded);
      button.querySelector<HTMLElement>("[data-user-chevron]")?.classList.toggle("rotate-90", expanded);
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-user-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const source = button.closest("td")?.querySelector<HTMLTextAreaElement>("[data-user-json]");
      if (!source) return;
      await navigator.clipboard.writeText(source.value);
      button.textContent = "Copied";
      window.setTimeout(() => {
        button.textContent = "Copy JSON";
      }, 1400);
    });
  });

  user_search?.addEventListener("input", () => {
    const query = user_search.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>("[data-user-row]").forEach((row) => {
      const matches = String(row.dataset.searchValue).includes(query);
      row.hidden = !matches;
      const user_id = row.dataset.userId;
      const details = user_id
        ? document.querySelector<HTMLTableRowElement>(`[data-user-details-for="${CSS.escape(user_id)}"]`)
        : null;
      const toggle = row.querySelector<HTMLButtonElement>("[data-user-toggle]");
      if (details) details.hidden = !matches || toggle?.getAttribute("aria-expanded") !== "true";
    });
  });
</script>
