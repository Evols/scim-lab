---
interface Props { flash: Record<string, unknown> }
const { flash } = Astro.props;
const type = String(flash.type ?? 'success');
const invite_url = typeof flash.invite_url === 'string' ? flash.invite_url : '';
const has_secret = Boolean(invite_url);
---

{has_secret ? (
	<dialog class="w-[min(92vw,520px)] rounded-lg border border-[#e4e4e7] bg-white p-0 text-[#09090b] shadow-2xl backdrop:bg-black/50" data-flash-dialog>
		<div class="p-6">
			<div class="flex items-start justify-between gap-4"><div><h2 class="text-lg font-semibold tracking-[-0.02em]">Sharing link</h2><p class="mt-1.5 text-sm leading-6 text-[#71717a]">{String(flash.message ?? '')}</p></div><button class="cursor-pointer text-lg leading-none text-[#a1a1aa] hover:text-[#09090b]" type="button" data-close-flash aria-label="Close">×</button></div>
			<div class="mt-5 space-y-3">
				<div><p class="mb-1.5 text-xs font-medium text-[#71717a]">URL</p><div class="flex items-center gap-2 rounded-md border border-[#e4e4e7] bg-[#fafafa] p-1.5 pl-3"><code class="min-w-0 flex-1 overflow-hidden text-ellipsis whitespace-nowrap font-mono text-xs">{invite_url}</code><button class="h-8 shrink-0 cursor-pointer rounded-md border border-[#e4e4e7] bg-white px-3 text-xs font-medium shadow-xs hover:bg-[#f4f4f5]" type="button" data-copy={invite_url}>Copy</button></div></div>
			</div>
			<div class="mt-6 flex justify-end"><button class="h-9 cursor-pointer rounded-md bg-[#18181b] px-4 text-sm font-medium text-white hover:bg-[#27272a]" type="button" data-close-flash>Done</button></div>
		</div>
	</dialog>
) : (
	<div class:list={['fixed bottom-4 right-4 z-50 flex max-w-sm items-start gap-3 rounded-lg border bg-white px-4 py-3 text-sm shadow-lg', type === 'error' ? 'border-[#fecaca]' : 'border-[#e4e4e7]']} role={type === 'error' ? 'alert' : 'status'}>
		<span class:list={['mt-0.5 grid size-5 shrink-0 place-items-center rounded-full text-[10px] text-white', type === 'error' ? 'bg-[#dc2626]' : 'bg-[#18181b]']}>{type === 'error' ? '!' : '✓'}</span>
		<p class="leading-5 text-[#3f3f46]">{String(flash.message ?? '')}</p>
	</div>
)}

<script>
	const flash_dialog = document.querySelector<HTMLDialogElement>('[data-flash-dialog]');
	if (flash_dialog && !flash_dialog.open) {
		flash_dialog.showModal();
	}
	document.querySelectorAll('[data-close-flash]').forEach((button) => button.addEventListener('click', () => flash_dialog?.close()));
</script>
