---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SCIM Lab — Provisioning without the ceremony",
  description = "Create a working SCIM v2 server in seconds, inspect every request, and test identity provisioning safely.",
} = Astro.props;
const current_year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="min-h-full bg-[#fafafa]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen min-w-80 bg-[#fafafa] font-sans text-[#09090b] antialiased selection:bg-[#e4e4e7] selection:text-[#09090b]"
  >
    <slot />
    <footer class="border-t border-[#e4e4e7] px-4 py-5 text-center text-xs text-[#71717a]">
      <a
        class="font-medium text-[#52525b] underline decoration-[#d4d4d8] underline-offset-4 hover:text-[#09090b]"
        href="https://github.com/Evols"
        target="_blank"
        rel="noreferrer">Baptiste Hutteau</a
      > · {current_year}
    </footer>
  </body>
</html>
