---
import type { task_record } from '../db/schema';
import TaskItem from './TaskItem.astro';

interface Props {
	tasks: task_record[];
	filter: 'all' | 'active' | 'done';
	total_count: number;
}

const { tasks, filter, total_count } = Astro.props;
---

<div>
	{tasks.length > 0 ? (
		<ul class="m-0 list-none p-0">
			{tasks.map((task, index) => <TaskItem task={task} filter={filter} is_first={index === 0} />)}
		</ul>
	) : (
		<div class="flex min-h-[290px] flex-col items-center justify-center px-6 py-[55px] text-center">
			<div class="mb-[18px] grid size-[46px] place-items-center rounded-full border border-dashed border-[#95ad97] bg-[rgba(77,132,89,0.06)] text-[#4d8459]" aria-hidden="true"><span>✓</span></div>
			<h2 class="mb-[7px] text-[19px] font-semibold tracking-[-0.03em]">{total_count === 0 ? 'A clear start.' : filter === 'done' ? 'Nothing checked off yet.' : 'Everything is complete.'}</h2>
			<p class="m-0 max-w-[360px] text-[13px] leading-[1.6] text-[#8b8e86]">{total_count === 0 ? 'Add your first task above and give today a little direction.' : filter === 'done' ? 'Finish something small—the momentum counts.' : 'Take a breath. You earned the quiet.'}</p>
		</div>
	)}
</div>
