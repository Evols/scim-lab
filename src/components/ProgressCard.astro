---
interface Props {
	progress: number;
	done_count: number;
	total_count: number;
	active_count: number;
}

const { progress, done_count, total_count, active_count } = Astro.props;
---

<section class="mt-4 grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border border-[#20231e]/15 bg-[rgba(240,237,226,0.66)] p-[19px_18px] md:grid-cols-[auto_1fr_auto] md:gap-6 md:px-6 md:py-[22px]" aria-label={`${progress}% complete`}>
	<div class="min-w-[110px]">
		<span class="mb-1.5 block font-['DM_Mono'] text-[9px] font-medium tracking-[0.13em] text-[#4d8459]">DAY'S PROGRESS</span>
		<strong class="font-['DM_Mono'] text-base font-medium">{done_count}<span class="text-[#a0a29b]"> / {total_count}</span></strong>
	</div>
	<progress class="h-[5px] w-full overflow-hidden rounded-full bg-[#20231e]/10 accent-[#4d8459]" value={progress} max="100" aria-hidden="true">{progress}%</progress>
	<p class="m-0 hidden text-xs text-[#83867e] md:block">{total_count === 0 ? 'Your slate is open.' : progress === 100 ? 'All wrapped up.' : `${active_count} ${active_count === 1 ? 'task' : 'tasks'} left.`}</p>
</section>
