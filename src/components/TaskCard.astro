---
import type { task_record } from '../db/schema';
import TaskComposer from './TaskComposer.astro';
import TaskFilters from './TaskFilters.astro';
import TaskList from './TaskList.astro';

interface Props {
	filter: 'all' | 'active' | 'done';
	tasks: task_record[];
	total_count: number;
	active_count: number;
	done_count: number;
}

const { filter, tasks, total_count, active_count, done_count } = Astro.props;
---

<section class="overflow-hidden rounded-2xl border border-[#20231e]/20 bg-[rgba(255,254,249,0.84)] shadow-[0_22px_70px_rgba(62,66,52,0.08)] backdrop-blur-xl" aria-label="Task list">
	<TaskComposer filter={filter} />
	<TaskFilters filter={filter} total_count={total_count} active_count={active_count} done_count={done_count} />
	<TaskList tasks={tasks} filter={filter} total_count={total_count} />
</section>
