---
import AppHeader from "../presentation/components/AppHeader.astro";
import Bootstrap from "../presentation/components/Bootstrap.astro";
import EndpointView from "../presentation/components/EndpointView.astro";
import FlashNotice from "../presentation/components/FlashNotice.astro";
import GroupsPanel from "../presentation/components/GroupsPanel.astro";
import LogsPanel from "../presentation/components/LogsPanel.astro";
import SettingsPanel from "../presentation/components/SettingsPanel.astro";
import UsersPanel from "../presentation/components/UsersPanel.astro";
import { list_console_events, list_console_groups, list_console_users } from "../lib/management/console";
import { read_server_credential } from "../lib/management/credential";
import { list_share_invites } from "../lib/management/invite";
import { generated_server_name } from "../lib/management/server-name";
import {
  get_server_lifecycle,
  list_servers_for_user,
  mark_server_deactivated,
  touch_server_console,
} from "../lib/management/server";
import {
  find_console_context,
  get_flash,
  persist_console_context,
  session_cookie_options,
} from "../lib/session/context";
import { BOOTSTRAP_COOKIE_NAME, create_bootstrap_challenge, local_return_path } from "../lib/session/bootstrap";
import { ProvisioningLimitError, TOUCH_INTERVAL_MS } from "../lib/session/anonymous";
import { db } from "../lib/database";
import Layout from "../presentation/layouts/Layout.astro";

export const prerender = false;

Astro.response.headers.set("cache-control", "private, no-store");
Astro.response.headers.set("x-frame-options", "DENY");
let context = await find_console_context(Astro.cookies, db);
if (context) Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
const challenge = context ? "" : create_bootstrap_challenge();
if (!context) Astro.cookies.set(BOOTSTRAP_COOKIE_NAME, challenge, session_cookie_options(600));
if (context && Astro.url.searchParams.get("signin") === "1") {
  const login_url = new URL("/auth/login", Astro.url);
  login_url.searchParams.set("return_to", local_return_path(Astro.url.searchParams.get("return_to")));
  return Astro.redirect(login_url.pathname + login_url.search, 303);
}
// Persist a sustained browser session before extending the initial token's
// seven-day activity window. Ordinary first visits/navigation remain stateless.
if (
  context?.provisional &&
  context.fresh_server &&
  Date.now() - context.provisional.created_at >= TOUCH_INTERVAL_MS &&
  get_server_lifecycle(context.fresh_server, true) === "active"
) {
  try {
    context = await persist_console_context(context, db, Astro.clientAddress);
  } catch (error) {
    if (error instanceof ProvisioningLimitError)
      return new Response(error.message, { status: 429, headers: { "retry-after": "60" } });
    throw error;
  }
}
const server_rows = !context
  ? []
  : context.provisional && context.fresh_server
    ? [{ server: context.fresh_server, creator: context.user }]
    : await list_servers_for_user(context.user.id, db);
const requested_server_id = Astro.url.searchParams.get("server");
const selected_access = server_rows.find(({ server }) => server.id === requested_server_id) ?? server_rows[0];
let lifecycle = selected_access
  ? get_server_lifecycle(selected_access.server, selected_access.creator.is_anonymous)
  : null;

if (selected_access && !context?.provisional && lifecycle !== "active") {
  selected_access.server = await mark_server_deactivated(
    selected_access.server,
    selected_access.creator.is_anonymous,
    db,
  );
  lifecycle = get_server_lifecycle(selected_access.server, selected_access.creator.is_anonymous);
} else if (selected_access && !context?.provisional) {
  await touch_server_console(selected_access.server.id, db);
}

const allowed_views = ["overview", "users", "groups", "logs", "settings"];
const requested_view = Astro.url.searchParams.get("view") ?? "overview";
const view = allowed_views.includes(requested_view) ? requested_view : "overview";
const status_filter = Astro.url.searchParams.get("status") ?? "";
const method_filter = Astro.url.searchParams.get("method") ?? "";

const flash = context && !context.provisional ? await get_flash(Astro.cookies, context.user.id, db) : null;

const selected_server = selected_access?.server;
const allow_create =
  !!context &&
  !context.user.is_anonymous &&
  server_rows.filter(({ server }) => server.created_by_user_id === context.user.id).length < 3;
const suggested_server_name = allow_create ? generated_server_name() : "";
const anonymous_credential =
  selected_server && context?.user.is_anonymous && lifecycle === "active"
    ? context.provisional
      ? { auth_mode: "bearer" as const, username: null, credential: context.provisional.bearer_token }
      : await read_server_credential(context.user.id, selected_server.id, db).catch(() => null)
    : null;
const [users, groups, events, invites] =
  selected_server && !context?.provisional
    ? await Promise.all([
        view === "users" ? list_console_users(selected_server.id, db) : Promise.resolve([]),
        view === "groups" ? list_console_groups(selected_server.id, db) : Promise.resolve([]),
        view === "logs"
          ? list_console_events(selected_server.id, status_filter, method_filter, db)
          : Promise.resolve([]),
        view === "settings" ? list_share_invites(selected_server.id, db) : Promise.resolve([]),
      ])
    : [[], [], [], []];
---

<Layout>
  {
    !context ? (
      <Bootstrap challenge={challenge} return_to={`${Astro.url.pathname}${Astro.url.search}`} />
    ) : (
      <>
        <AppHeader
          user={context.user}
          servers={server_rows}
          selected_server={selected_server}
          view={view}
          allow_create={allow_create}
          suggested_server_name={suggested_server_name}
          selected_lifecycle={lifecycle}
        />
        {flash && <FlashNotice flash={flash} />}

        {!selected_server ? (
          <main class="grid min-h-[calc(100svh-3.5rem)] place-items-center px-4 py-10 sm:py-16">
            <section class="w-full max-w-md rounded-lg border border-[#e4e4e7] bg-white p-6 text-center shadow-sm">
              <p class="mt-2 text-sm leading-6 text-[#71717a]">
                Your endpoint and bearer token will be ready immediately.
              </p>
              {context.user.is_anonymous ? (
                <a
                  class="mt-5 inline-flex h-9 items-center rounded-md bg-[#18181b] px-4 text-sm font-medium text-white no-underline"
                  href="/auth/login"
                >
                  Sign in to continue
                </a>
              ) : (
                <form class="mt-5 flex flex-col gap-2 sm:flex-row" action="/api/console" method="POST">
                  <input type="hidden" name="intent" value="create_server" />
                  <input
                    class="h-9 min-w-0 flex-1 rounded-md border border-[#d4d4d8] px-3 text-sm shadow-xs"
                    name="name"
                    value={suggested_server_name}
                    required
                  />
                  <button class="h-10 rounded-md bg-[#18181b] px-4 text-sm font-medium text-white sm:h-9" type="submit">
                    Create
                  </button>
                </form>
              )}
            </section>
          </main>
        ) : lifecycle !== "active" ? (
          <main class="grid min-h-[calc(100svh-6.5rem)] place-items-center px-4 py-10 md:min-h-[calc(100vh-3.5rem)] md:py-16">
            <section class="w-full max-w-md rounded-lg border border-[#e4e4e7] bg-white p-6 text-center shadow-sm">
              <p class="mt-2 text-sm leading-6 text-[#71717a]">
                SCIM requests are paused because this console was inactive.
              </p>
              {context.user.is_anonymous ? (
                <a
                  class="mt-5 inline-flex h-9 items-center rounded-md bg-[#18181b] px-4 text-sm font-medium text-white no-underline"
                  href="/auth/login"
                >
                  Sign in to reactivate
                </a>
              ) : lifecycle === "deactivated" ? (
                <form class="mt-5" action="/api/console" method="POST">
                  <input type="hidden" name="intent" value="reactivate_server" />
                  <input type="hidden" name="server_id" value={selected_server.id} />
                  <button
                    class="h-9 cursor-pointer rounded-md bg-[#18181b] px-4 text-sm font-medium text-white"
                    type="submit"
                  >
                    Reactivate
                  </button>
                </form>
              ) : (
                <p class="mt-4 text-sm font-medium text-[#dc2626]">The recovery window has expired.</p>
              )}
            </section>
          </main>
        ) : view === "overview" ? (
          <EndpointView
            server={selected_server}
            origin={Astro.url.origin}
            is_anonymous={context.user.is_anonymous}
            anonymous_credential={anonymous_credential}
          />
        ) : (
          <main class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-10">
            {view === "users" && <UsersPanel users={users} />}
            {view === "groups" && <GroupsPanel groups={groups} />}
            {view === "logs" && (
              <LogsPanel
                events={events}
                server_id={selected_server.id}
                status_filter={status_filter}
                method_filter={method_filter}
              />
            )}
            {view === "settings" && (
              <SettingsPanel server={selected_server} invites={invites} is_anonymous={context.user.is_anonymous} />
            )}
          </main>
        )}
      </>
    )
  }

  <script>
    document.querySelectorAll<HTMLElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.copy;
        if (!value) {
          return;
        }
        await navigator.clipboard.writeText(value);
        const previous = button.textContent;
        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = previous;
        }, 1400);
      });
    });
  </script>
</Layout>
