---
import Layout from '../layouts/Layout.astro';
import { createTask, clearCompletedTasks, deleteTask, listTasks, setTaskCompleted } from '../db';

export const prerender = false;

type Filter = 'all' | 'active' | 'done';

const safeRedirect = (filter: string | null) => {
	const selected = filter === 'active' || filter === 'done' ? filter : 'all';
	return selected === 'all' ? '/' : `/?filter=${selected}`;
};

if (Astro.request.method === 'POST') {
	const origin = Astro.request.headers.get('origin');
	if (origin && origin !== Astro.url.origin) return new Response('Invalid request origin.', { status: 403 });

	const form = await Astro.request.formData();
	const intent = String(form.get('intent') ?? '');
	const filter = String(form.get('filter') ?? 'all');

	if (intent === 'create') {
		const title = String(form.get('title') ?? '').trim().replace(/\s+/g, ' ');
		if (title) await createTask(title.slice(0, 160));
	}

	if (intent === 'toggle') {
		const id = String(form.get('id') ?? '');
		if (id) await setTaskCompleted(id, form.get('completed') === 'true');
	}

	if (intent === 'delete') {
		const id = String(form.get('id') ?? '');
		if (id) await deleteTask(id);
	}

	if (intent === 'clear') await clearCompletedTasks();
	return Astro.redirect(safeRedirect(filter), 303);
}

const requestedFilter = Astro.url.searchParams.get('filter');
const filter: Filter = requestedFilter === 'active' || requestedFilter === 'done' ? requestedFilter : 'all';
const tasks = await listTasks();
const activeCount = tasks.filter((task) => !task.completed).length;
const doneCount = tasks.length - activeCount;
const visibleTasks = tasks.filter((task) => {
	if (filter === 'active') return !task.completed;
	if (filter === 'done') return task.completed;
	return true;
});
const progress = tasks.length === 0 ? 0 : Math.round((doneCount / tasks.length) * 100);
const today = new Intl.DateTimeFormat('en', {
	weekday: 'long',
	month: 'short',
	day: 'numeric',
	timeZone: 'Europe/Paris',
}).format(new Date());
---

<Layout>
	<div class="shell">
		<header class="topbar">
			<a class="brand" href="/" aria-label="Tempo home">
				<span class="brand-mark" aria-hidden="true">✓</span>
				<span>tempo</span>
			</a>
			<div class="date-lockup"><span class="date-dot" aria-hidden="true"></span>{today}</div>
		</header>

		<main>
			<section class="intro" aria-labelledby="page-title">
				<div>
					<p class="eyebrow">TODAY'S FOCUS</p>
					<h1 id="page-title">Make today count.</h1>
				</div>
				<p class="intro-copy">A calm place for the things that matter. Add a task, clear your head, and keep moving.</p>
			</section>

			<section class="task-card" aria-label="Task list">
				<form class="composer" method="POST">
					<input type="hidden" name="intent" value="create" />
					<input type="hidden" name="filter" value={filter} />
					<label class="sr-only" for="new-task">What needs to be done?</label>
					<span class="composer-plus" aria-hidden="true">+</span>
					<input id="new-task" name="title" type="text" maxlength="160" placeholder="What needs to be done?" autocomplete="off" required />
					<button type="submit">Add task <span aria-hidden="true">↗</span></button>
				</form>

				<div class="filters-row">
					<nav class="filters" aria-label="Filter tasks">
						<a class:list={[{ active: filter === 'all' }]} href="/">All <span>{tasks.length}</span></a>
						<a class:list={[{ active: filter === 'active' }]} href="/?filter=active">Active <span>{activeCount}</span></a>
						<a class:list={[{ active: filter === 'done' }]} href="/?filter=done">Done <span>{doneCount}</span></a>
					</nav>
					{doneCount > 0 && (
						<form method="POST">
							<input type="hidden" name="intent" value="clear" />
							<input type="hidden" name="filter" value={filter} />
							<button class="clear-button" type="submit">Clear completed</button>
						</form>
					)}
				</div>

				<div class="list-region">
					{visibleTasks.length > 0 ? (
						<ul class="task-list">
							{visibleTasks.map((task, index) => (
								<li class:list={['task-item', { completed: task.completed }]}>
									<form method="POST" class="toggle-form">
										<input type="hidden" name="intent" value="toggle" />
										<input type="hidden" name="id" value={task.id} />
										<input type="hidden" name="completed" value={String(!task.completed)} />
										<input type="hidden" name="filter" value={filter} />
										<button class="check-button" type="submit" aria-label={task.completed ? `Mark ${task.title} active` : `Mark ${task.title} complete`} aria-pressed={task.completed}>
											<span aria-hidden="true">{task.completed ? '✓' : ''}</span>
										</button>
									</form>
									<div class="task-copy">
										<p>{task.title}</p>
										<span>{task.completed ? 'Completed' : index === 0 && filter !== 'done' ? 'Up next' : 'Open'}</span>
									</div>
									<form method="POST" class="delete-form">
										<input type="hidden" name="intent" value="delete" />
										<input type="hidden" name="id" value={task.id} />
										<input type="hidden" name="filter" value={filter} />
										<button type="submit" aria-label={`Delete ${task.title}`}>Delete</button>
									</form>
								</li>
							))}
						</ul>
					) : (
						<div class="empty-state">
							<div class="empty-ring" aria-hidden="true"><span>✓</span></div>
							<h2>{tasks.length === 0 ? 'A clear start.' : filter === 'done' ? 'Nothing checked off yet.' : 'Everything is complete.'}</h2>
							<p>{tasks.length === 0 ? 'Add your first task above and give today a little direction.' : filter === 'done' ? 'Finish something small—the momentum counts.' : 'Take a breath. You earned the quiet.'}</p>
						</div>
					)}
				</div>
			</section>

			<section class="progress-card" aria-label={`${progress}% complete`}>
				<div>
					<span class="progress-label">DAY'S PROGRESS</span>
					<strong>{doneCount}<span> / {tasks.length}</span></strong>
				</div>
				<div class="progress-track" aria-hidden="true"><span style={`width: ${progress}%`}></span></div>
				<p>{tasks.length === 0 ? 'Your slate is open.' : progress === 100 ? 'All wrapped up.' : `${activeCount} ${activeCount === 1 ? 'task' : 'tasks'} left.`}</p>
			</section>
		</main>

		<footer><p>ONE THING AT A TIME.</p><span>Built for focus, not frenzy.</span></footer>
	</div>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('.composer');
	form?.addEventListener('submit', () => {
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (button) {
			button.disabled = true;
			button.textContent = 'Adding…';
		}
	});
</script>

<style>
	:global(body) {
		background: radial-gradient(circle at 9% 12%, rgba(116, 160, 114, 0.1), transparent 26rem), linear-gradient(rgba(32, 35, 30, 0.026) 1px, transparent 1px), #f4f1e8;
		background-size: auto, 100% 32px, auto;
	}
	:global(button:focus-visible), :global(a:focus-visible), :global(input:focus-visible) { outline: 3px solid rgba(47, 94, 57, 0.35); outline-offset: 3px; }
	.shell { width: min(100% - 40px, 1040px); min-height: 100vh; margin: 0 auto; display: flex; flex-direction: column; }
	.topbar { height: 88px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(32, 35, 30, 0.2); }
	.brand { display: inline-flex; align-items: center; gap: 11px; color: #20231e; font-size: 20px; font-weight: 700; letter-spacing: -0.04em; text-decoration: none; }
	.brand-mark { width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid #20231e; border-radius: 50%; font-size: 16px; }
	.date-lockup { display: flex; align-items: center; gap: 10px; color: #64675f; font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; }
	.date-dot { width: 7px; height: 7px; border-radius: 50%; background: #4d8459; box-shadow: 0 0 0 4px rgba(77, 132, 89, 0.12); }
	main { flex: 1; padding: 66px 0 48px; }
	.intro { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(240px, 0.7fr); gap: 44px; align-items: end; margin-bottom: 42px; }
	.eyebrow, .progress-label, footer p { margin: 0 0 13px; color: #4d8459; font-family: 'DM Mono', monospace; font-size: 11px; font-weight: 500; letter-spacing: 0.13em; }
	h1 { max-width: 690px; margin: 0; font-size: clamp(44px, 7vw, 78px); font-weight: 500; line-height: 0.98; letter-spacing: -0.065em; }
	.intro-copy { margin: 0 0 3px; color: #6a6c65; font-size: 14px; line-height: 1.7; }
	.task-card { overflow: hidden; border: 1px solid rgba(32, 35, 30, 0.22); border-radius: 16px; background: rgba(255, 254, 249, 0.84); box-shadow: 0 22px 70px rgba(62, 66, 52, 0.08); backdrop-filter: blur(12px); }
	.composer { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; padding: 18px 18px 18px 24px; border-bottom: 1px solid rgba(32, 35, 30, 0.16); }
	.composer-plus { color: #4d8459; font-size: 27px; line-height: 1; }
	.composer input[type='text'] { width: 100%; min-width: 0; padding: 13px 0; border: 0; outline: 0; color: #20231e; background: transparent; font-size: 17px; }
	.composer input::placeholder { color: #92948d; }
	.composer button { min-height: 45px; padding: 0 19px; border: 0; border-radius: 9px; color: #f8f7f1; background: #2f5e39; font-size: 13px; font-weight: 600; cursor: pointer; transition: transform 160ms ease, background 160ms ease; }
	.composer button:hover { background: #244c2d; transform: translateY(-1px); }
	.composer button:disabled { cursor: wait; opacity: 0.7; }
	.filters-row { min-height: 65px; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid rgba(32, 35, 30, 0.12); }
	.filters { display: flex; align-items: center; gap: 26px; }
	.filters a { position: relative; padding: 22px 0 19px; color: #83867e; font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.04em; text-decoration: none; text-transform: uppercase; }
	.filters a::after { position: absolute; inset: auto 0 -1px; height: 2px; content: ''; background: transparent; }
	.filters a.active { color: #20231e; }
	.filters a.active::after { background: #4d8459; }
	.filters span { margin-left: 4px; color: #afb1aa; }
	.clear-button, .delete-form button { padding: 6px 0; border: 0; color: #8c8e87; background: transparent; font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer; }
	.clear-button:hover, .delete-form button:hover { color: #a24a3e; }
	.task-list { margin: 0; padding: 0; list-style: none; }
	.task-item { min-height: 82px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 17px; padding: 15px 24px; border-bottom: 1px solid rgba(32, 35, 30, 0.1); transition: background 150ms ease; }
	.task-item:last-child { border-bottom: 0; }
	.task-item:hover { background: rgba(244, 241, 232, 0.55); }
	.toggle-form, .delete-form { margin: 0; }
	.check-button { width: 24px; height: 24px; display: grid; place-items: center; padding: 0; border: 1.5px solid #9a9d95; border-radius: 50%; color: #fff; background: transparent; font-size: 13px; cursor: pointer; transition: border-color 150ms ease, background 150ms ease, transform 150ms ease; }
	.check-button:hover { border-color: #4d8459; transform: scale(1.08); }
	.completed .check-button { border-color: #4d8459; background: #4d8459; }
	.task-copy { min-width: 0; }
	.task-copy p { margin: 0; overflow-wrap: anywhere; font-size: 14px; font-weight: 600; letter-spacing: -0.01em; }
	.task-copy span { display: block; margin-top: 6px; color: #9a9c95; font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: 0.11em; text-transform: uppercase; }
	.completed .task-copy p { color: #a2a49e; text-decoration: line-through; text-decoration-color: #83867e; }
	.delete-form button { opacity: 0; transition: opacity 150ms ease, color 150ms ease; }
	.task-item:hover .delete-form button, .delete-form button:focus-visible { opacity: 1; }
	.empty-state { min-height: 290px; padding: 55px 24px; display: flex; align-items: center; justify-content: center; flex-direction: column; text-align: center; }
	.empty-ring { width: 46px; height: 46px; margin-bottom: 18px; display: grid; place-items: center; border: 1px dashed #95ad97; border-radius: 50%; color: #4d8459; background: rgba(77, 132, 89, 0.06); }
	.empty-state h2 { margin: 0 0 7px; font-size: 19px; font-weight: 600; letter-spacing: -0.03em; }
	.empty-state p { max-width: 360px; margin: 0; color: #8b8e86; font-size: 13px; line-height: 1.6; }
	.progress-card { margin-top: 16px; padding: 22px 24px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 24px; border: 1px solid rgba(32, 35, 30, 0.18); border-radius: 12px; background: rgba(240, 237, 226, 0.66); }
	.progress-card > div:first-child { min-width: 110px; }
	.progress-label { display: block; margin-bottom: 6px; font-size: 9px; }
	.progress-card strong { font-family: 'DM Mono', monospace; font-size: 16px; font-weight: 500; }
	.progress-card strong span { color: #a0a29b; }
	.progress-track { height: 5px; overflow: hidden; border-radius: 999px; background: rgba(32, 35, 30, 0.1); }
	.progress-track span { display: block; height: 100%; border-radius: inherit; background: #4d8459; transition: width 300ms ease; }
	.progress-card p { margin: 0; color: #83867e; font-size: 12px; }
	footer { min-height: 100px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-top: 1px solid rgba(32, 35, 30, 0.2); color: #999b94; font-size: 11px; }
	footer p { margin: 0; color: #686b63; }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

	@media (max-width: 700px) {
		.shell { width: min(100% - 24px, 1040px); }
		.topbar { height: 72px; }
		main { padding: 46px 0 36px; }
		.intro { grid-template-columns: 1fr; gap: 21px; margin-bottom: 30px; }
		h1 { font-size: clamp(44px, 15vw, 64px); }
		.intro-copy { max-width: 440px; }
		.composer { grid-template-columns: auto 1fr; padding: 15px 18px; }
		.composer button { grid-column: 1 / -1; width: 100%; }
		.filters-row { padding: 0 18px; }
		.filters { gap: 18px; }
		.clear-button { font-size: 0; }
		.clear-button::after { content: 'Clear'; font-size: 10px; }
		.task-item { padding: 15px 18px; }
		.delete-form button { opacity: 1; }
		.progress-card { grid-template-columns: auto 1fr; gap: 16px; padding: 19px 18px; }
		.progress-card p { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
	}
</style>
