---
import AppFooter from '../components/AppFooter.astro';
import AppHeader from '../components/AppHeader.astro';
import IntroSection from '../components/IntroSection.astro';
import ProgressCard from '../components/ProgressCard.astro';
import TaskCard from '../components/TaskCard.astro';
import { clear_completed_tasks, create_task, delete_task, list_tasks, set_task_completed } from '../db';
import Layout from '../layouts/Layout.astro';

export const prerender = false;

type task_filter = 'all' | 'active' | 'done';

async function handle_post(): Promise<Response | undefined> {
	if (Astro.request.method !== 'POST') return;

	const origin = Astro.request.headers.get('origin');
	if (origin && origin !== Astro.url.origin) return new Response('Invalid request origin.', { status: 403 });

	const form = await Astro.request.formData();
	const intent = String(form.get('intent') ?? '');
	const filter = String(form.get('filter') ?? 'all');

	if (intent === 'create') {
		const title = String(form.get('title') ?? '').trim().replace(/\s+/g, ' ');
		if (title) await create_task(title.slice(0, 160));
	}

	if (intent === 'toggle') {
		const id = String(form.get('id') ?? '');
		if (id) await set_task_completed(id, form.get('completed') === 'true');
	}

	if (intent === 'delete') {
		const id = String(form.get('id') ?? '');
		if (id) await delete_task(id);
	}

	if (intent === 'clear') await clear_completed_tasks();
	const selected_filter = filter === 'active' || filter === 'done' ? filter : 'all';
	const redirect_path = selected_filter === 'all' ? '/' : `/?filter=${selected_filter}`;
	return Astro.redirect(redirect_path, 303);
}

const post_response = await handle_post();
if (post_response) return post_response;

const requested_filter = Astro.url.searchParams.get('filter');
const filter: task_filter = requested_filter === 'active' || requested_filter === 'done' ? requested_filter : 'all';
const tasks = await list_tasks();
const active_count = tasks.filter((task) => !task.completed).length;
const done_count = tasks.length - active_count;
const visible_tasks = tasks.filter((task) => {
	if (filter === 'active') return !task.completed;
	if (filter === 'done') return task.completed;
	return true;
});
const progress = tasks.length === 0 ? 0 : Math.round((done_count / tasks.length) * 100);
const today = new Intl.DateTimeFormat('en', {
	weekday: 'long',
	month: 'short',
	day: 'numeric',
	timeZone: 'Europe/Paris',
}).format(new Date());
---

<Layout>
	<div class="pointer-events-none fixed inset-0 bg-[radial-gradient(circle_at_9%_12%,rgba(116,160,114,0.1),transparent_26rem)]" aria-hidden="true"></div>
	<div class="pointer-events-none fixed inset-0 bg-[linear-gradient(rgba(32,35,30,0.026)_1px,transparent_1px)] bg-[length:100%_32px]" aria-hidden="true"></div>
	<div class="relative z-10 mx-auto flex min-h-screen w-[min(calc(100%_-_24px),1040px)] flex-col md:w-[min(calc(100%_-_40px),1040px)]">
		<AppHeader today={today} />
		<main class="flex-1 py-9 md:py-[66px] md:pb-12">
			<IntroSection />
			<TaskCard filter={filter} tasks={visible_tasks} total_count={tasks.length} active_count={active_count} done_count={done_count} />
			<ProgressCard progress={progress} done_count={done_count} total_count={tasks.length} active_count={active_count} />
		</main>
		<AppFooter />
	</div>
</Layout>
