    {
      "id": 6,
      "title": "Daily account signups (UTC)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "scim-lab-metrics"
      },
      "description": "Uses account upgrade time, with creation time as a fallback. Counts retained registered accounts; removed accounts disappear. Zero-filled UTC days in the selected interval.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "scim-lab-metrics"
          },
          "rawQuery": true,
          "rawSql": "SELECT days.time, coalesce(signups.registrations, 0) AS registrations\nFROM generate_series(date_trunc('day', $__timeFrom()::timestamptz AT TIME ZONE 'UTC') AT TIME ZONE 'UTC', date_trunc('day', $__timeTo()::timestamptz AT TIME ZONE 'UTC') AT TIME ZONE 'UTC', interval '1 day') AS days(time)\nLEFT JOIN metrics.registrations_daily AS signups ON signups.time = days.time\nWHERE (SELECT refreshed_at IS NOT NULL FROM metrics.refresh_status)\nORDER BY days.time",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "title": "Anonymous accounts by last login (UTC)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "scim-lab-metrics"
      },
      "description": "Retained anonymous accounts grouped by their latest known console activity: creation, account activity, or a refreshed legacy session. Each account appears once, on its most recent UTC day. First visits are included. Provisional browser workspaces are excluded. Activity has up to 15 minutes of timestamp rounding; expired sessions can remove older activity evidence. Zero-filled days follow the selected interval.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "scim-lab-metrics"
          },
          "rawQuery": true,
          "rawSql": "SELECT days.time, coalesce(activity.anonymous_accounts, 0) AS anonymous_accounts\nFROM generate_series(date_trunc('day', $__timeFrom()::timestamptz AT TIME ZONE 'UTC') AT TIME ZONE 'UTC', date_trunc('day', $__timeTo()::timestamptz AT TIME ZONE 'UTC') AT TIME ZONE 'UTC', interval '1 day') AS days(time)\nLEFT JOIN metrics.anonymous_last_login_daily AS activity ON activity.time = days.time\nWHERE (SELECT refreshed_at IS NOT NULL FROM metrics.refresh_status)\nORDER BY days.time",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "displayName": "Anonymous accounts",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
