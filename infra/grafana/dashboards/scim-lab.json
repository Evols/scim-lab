{
  "uid": "scim-lab",
  "title": "SCIM Lab",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "tags": ["scim-lab"],
  "timezone": "utc",
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "Live database aggregates. Accounts are console sign-ins; provisioned SCIM users cannot sign in. Daily signups reflect retained accounts; deleted rows are not historical snapshots.",
  "panels": [
    {
      "id": 1,
      "title": "Registered accounts",
      "description": "Console accounts upgraded through OpenID Connect.",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "scim-lab-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "scim-lab-metrics"
          },
          "rawQuery": true,
          "rawSql": "SELECT registered_accounts FROM metrics.overview",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
