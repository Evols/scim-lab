{
  "uid": "scim-lab",
  "title": "SCIM Lab",
  "schemaVersion": 41,
  "version": 3,
  "editable": false,
  "tags": ["scim-lab"],
  "timezone": "utc",
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "Cached database aggregates rebuilt in the background every 15 minutes by default. Check Metrics last refreshed for snapshot age. First refresh can take several minutes on a large database. Counts reflect retained accounts, not historical snapshots.",
  "panels": [
    {
      "id": 8,
      "title": "Metrics last refreshed",
      "description": "Last successful background snapshot. Initial refresh pending means the first scan has not completed. Refresh failures preserve the previous snapshot and timestamp. The worker pauses 15 minutes between refreshes by default.",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "scim-lab-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "scim-lab-metrics"
          },
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM refreshed_at) * 1000 AS refreshed_at FROM metrics.refresh_status",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "Initial refresh pending",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 1,
